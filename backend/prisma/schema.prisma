generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
  SOLD
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id             String                    @id @default(uuid()) @db.Uuid
  email          String                    @unique
  displayName    String                    @db.VarChar(80)
  passwordHash   String
  sessionVersion Int                       @default(0)
  status         UserStatus                @default(ACTIVE)
  roleId         String                    @db.Uuid
  role           Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  posts          Post[]
  comments       Comment[]
  conversations  ConversationParticipant[]
  messages       Message[]
  reportsMade    Report[]                  @relation("Reporter")
  reportsAgainst Report[]                  @relation("ReportedUser")
  auditLogs      AuditLog[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([roleId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  active    Boolean  @default(true)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id          String      @id @default(uuid()) @db.Uuid
  authorId    String      @db.Uuid
  author      User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId  String      @db.Uuid
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title       String      @db.VarChar(120)
  description String
  price       Int?
  status      PostStatus  @default(PENDING)
  images      PostImage[]
  comments    Comment[]
  reports     Report[]
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, deletedAt, createdAt, id])
  @@index([categoryId, status, deletedAt, createdAt])
  @@index([authorId, deletedAt, createdAt])
}

model PostImage {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Restrict)
  url       String
  position  Int
  createdAt DateTime @default(now())

  @@unique([postId, position])
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid
  post      Post      @relation(fields: [postId], references: [id], onDelete: Restrict)
  authorId  String    @db.Uuid
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentId  String?   @db.Uuid
  parent    Comment?  @relation("Replies", fields: [parentId, postId], references: [id, postId], onDelete: Restrict)
  replies   Comment[] @relation("Replies")
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([id, postId])
  @@index([parentId, postId])
  @@index([postId, createdAt])
  @@index([authorId])
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  participants ConversationParticipant[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages       Message[]
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model Message {
  id             String                  @id @default(uuid()) @db.Uuid
  conversationId String                  @db.Uuid
  senderId       String                  @db.Uuid
  sender         User                    @relation(fields: [senderId], references: [id], onDelete: Restrict)
  participant    ConversationParticipant @relation(fields: [conversationId, senderId], references: [conversationId, userId], onDelete: Restrict)
  body           String
  createdAt      DateTime                @default(now())

  @@index([conversationId, createdAt, id])
  @@index([senderId])
}

model Report {
  id             String       @id @default(uuid()) @db.Uuid
  reporterId     String       @db.Uuid
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  postId         String?      @db.Uuid
  post           Post?        @relation(fields: [postId], references: [id], onDelete: Restrict)
  reportedUserId String?      @db.Uuid
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Restrict)
  reason         String
  status         ReportStatus @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([postId])
  @@index([reportedUserId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(40)
  entityId   String   @db.Uuid
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}
