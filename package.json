{
  "name": "bav-connect",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10"
  },
  "overrides": {
    "vitest": {
      "vite": "^7.3.0"
    },
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "install": "npm run db:generate",
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:preview": "concurrently --kill-others-on-fail --names api,web \"npm run dev:preview -w backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces && eslint scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces",
    "test:integration": "npm run test:integration -w backend",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend --",
    "db:deploy": "npm run db:deploy -w backend",
    "db:admin": "npm run db:admin -w backend --",
    "check:changes": "node scripts/check-changes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
